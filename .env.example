# Azure Storage
BLOB_ACCOUNT_URL="https://<storage-account>.blob.core.windows.net"
BLOB_CONN_STR=""  # Optional: leave blank when using DefaultAzureCredential
INPUT_CONTAINER="input-container"
OUTPUT_CONTAINER="output-container"

# Azure AI Foundry
PROJECT_ENDPOINT="https://<ai-foundry-resource>.services.ai.azure.com/api/projects/<project-name>"
MODEL_DEPLOYMENT_NAME="model-deployment"  # Name of your deployed model in AI Foundry

# Logging
AZURE_LOG_LEVEL="INFO"